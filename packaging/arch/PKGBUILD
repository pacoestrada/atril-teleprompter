# Maintainer: Paco Estrada
pkgname=atril-teleprompter
pkgver=1.0.0
pkgrel=1
pkgdesc='Offline teleprompter for scripts, videos and podcasts by Paco Estrada / Compilando'
arch=('any')
url='https://github.com/pacoestrada/atril-teleprompter'
license=('GPL-3.0-or-later')
depends=('python>=3.10' 'python-pyqt5>=5.15')
checkdepends=('desktop-file-utils' 'ttf-dejavu')
optdepends=('ttf-dejavu: preferred font for the interface and reading area')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('e992b41d9847a421c5bfe2200e3abb3163e939e5f0861dc359233b91401b46b3')

check() {
    cd "${pkgname}-${pkgver}"
    QT_QPA_PLATFORM=offscreen python -m unittest discover -s tests -v
    python atril.py --version
    desktop-file-validate packaging/es.compilando.AtrilTeleprompter.desktop
}

package() {
    cd "${pkgname}-${pkgver}"
    install -Dm644 atril.py core.py -t "${pkgdir}/usr/share/${pkgname}"
    install -Dm644 assets/atril.png assets/compilando-podcast-logo.jpg \
        -t "${pkgdir}/usr/share/${pkgname}/assets"
    install -Dm644 packaging/es.compilando.AtrilTeleprompter.desktop \
        -t "${pkgdir}/usr/share/applications"
    install -Dm644 assets/atril.png \
        "${pkgdir}/usr/share/pixmaps/es.compilando.AtrilTeleprompter.png"
    install -Dm644 README.md THIRD_PARTY.md -t "${pkgdir}/usr/share/doc/${pkgname}"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -d "${pkgdir}/usr/bin"
    printf '%s\n' '#!/bin/sh' \
        'exec /usr/bin/python /usr/share/atril-teleprompter/atril.py "$@"' \
        > "${pkgdir}/usr/bin/${pkgname}"
    chmod 755 "${pkgdir}/usr/bin/${pkgname}"
}
